# =============================================================================
# Packrat environment template
#
# Copy to .env.dev (local/staging) or .env.prod (production) and fill in values.
# Read locally by the dev start scripts and in Docker via `--env-file`.
#
# Legend:
#   [secret]  sensitive — never commit a filled-in copy
#   [req]     required at startup (server refuses to boot without it)
#   [prod]    required in production; a dev-safe default is used otherwise
# =============================================================================

# ---------- NODE / ENVIRONMENT ----------
NODE_ENV=                                 # production | development

# ---------- DATABASE ----------
MYSQL_ROOT_PASSWORD=                      # [secret]
PACKRAT_DB_PORT=                          # host port mapped to container 3306
PACKRAT_DATABASE_URL=                     # [secret][req] mysql://user:pass@host:3306/db?connection_limit=25

# ---------- CLIENT / ENDPOINTS ----------
PACKRAT_CLIENT_PORT=
PACKRAT_CLIENT_ENDPOINT=                  # [prod] browser-facing client URL
REACT_APP_PACKRAT_SERVER_ENDPOINT=        # [prod] baked into the client at BUILD time (rebuild to change)

# ---------- SERVER ----------
PACKRAT_SERVER_PORT=                      # Express + GraphQL + WebDAV (default 4000)
PACKRAT_SESSION_SECRET=                   # [secret][req in prod] session signing key
PACKRAT_ITOPS_EMAIL=                      # comma-separated ops notification recipients

# ---------- STORAGE (OCFL) ----------
PACKRAT_OCFL_STORAGE_ROOT=                # [req] durable repository root (NAS/Qumulo)
PACKRAT_OCFL_STAGING_ROOT=                # [req] transient staging — MUST be local disk (random I/O, zip extraction)
PACKRAT_LOG_ROOT=                         # writable log directory

# ---------- EDAN (Smithsonian distribution) ----------
PACKRAT_EDAN_SERVER=                      # [prod]
PACKRAT_EDAN_3D_API=                      # [prod]
PACKRAT_EDAN_APPID=
PACKRAT_EDAN_AUTH_KEY=                    # [secret][prod]
PACKRAT_EDAN_UPSERT_RESOURCE_ROOT=
PACKRAT_EDAN_STAGING_ROOT=
PACKRAT_EDAN_RESOURCES_HOTFOLDER=
# Set to true/1 for local/dev only: publish continues (logs a warning) when EDAN returns an
# unresolved-subject title. Leave unset in production so the strict check blocks broken titles.
PACKRAT_EDAN_ALLOW_UNRESOLVED_SUBJECT=
# Comma-separated Unit abbreviations whose Subjects may have their EDAN published state changed
# (admin-only in addition). Default: OCIO,DPO,ODI. Restricts the control pending EDAN owner sign-off.
PACKRAT_SUBJECT_PUBLISH_UNITS=

# ---------- COOK (model processing) ----------
PACKRAT_COOK_SERVER_URL=                  # [prod] comma-separated Cook base URLs

# ---------- AUTH / LDAP ----------
PACKRAT_AUTH_TYPE=                        # LDAP | local
PACKRAT_LDAP_SERVER=                      # required when AUTH_TYPE=LDAP
PACKRAT_LDAP_PASSWORD=                    # [secret] required when AUTH_TYPE=LDAP
PACKRAT_LDAP_CN=
PACKRAT_LDAP_OU=
PACKRAT_LDAP_DC=
PACKRAT_LDAP_CA=                          # on-disk path to the LDAPS CA certificate

# ---------- EMAIL / SMTP ----------
PACKRAT_SMTP_HOST=
PACKRAT_SMTP_PORT=
PACKRAT_SMTP_SECURE=                      # true | false
PACKRAT_SMTP_AUTHUSER=
PACKRAT_SMTP_AUTHPASSWORD=                # [secret]

# ---------- SLACK (notifications) ----------
PACKRAT_SLACK_KEY=                        # [secret]
PACKRAT_SLACK_CHANNELS=                   # comma-separated channel IDs

# ---------- SOLR ----------
PACKRAT_SOLR_HOST=                        # Solr hostname (docker service name)
PACKRAT_SOLR_PORT=                        # container port map only — the app uses 8983 internally
PACKRAT_SOLR_REINDEX_SCHEDULE=            # node-schedule cron; default '0 0 * * *' (midnight daily)

# ---------- NAVIGATION ----------
PACKRAT_NAVIGATION_TYPE=                  # solr (default) | db

# ---------- LOGGING ----------
PACKRAT_LOG_RATE=                         # RecordKeeper target rate; default 100

# ---------- AUDIT RETENTION ----------
PACKRAT_AUDIT_TIER_STANDARD_FULL_DAYS=    # default 30
PACKRAT_AUDIT_TIER_STANDARD_SKELETON_DAYS= # default 'forever'
PACKRAT_AUDIT_TIER_TRANSIENT_FULL_DAYS=   # default 30
PACKRAT_AUDIT_TIER_TRANSIENT_SKELETON_DAYS= # default 90
PACKRAT_AUDIT_RETENTION_BATCH_SIZE=       # default 5000
PACKRAT_AUDIT_RETENTION_CRON=             # default '0 3 * * *'
PACKRAT_AUDIT_TX_STATEMENT_TIMEOUT_MS=    # default 60000
PACKRAT_AUDIT_TX_DEADLOCK_RETRIES=        # default 3

# ---------- INGEST / FEATURES ----------
# Set to true/1 to enable per-slice header validation of image-stack ZIPs.
# Off by default — it is O(slices) and slow on large stacks.
PACKRAT_VOLUME_PER_SLICE_VALIDATION=
# Set to true/1 to enable user-facing volumetric ingest (UI option + upload/ingest paths).
# Off by default — the datatype is gated pending stakeholder sign-off.
PACKRAT_INGEST_VOLUMETRIC=
# Upload package/asset-type compatibility check: off | warn | enforce.
# off (default) disables it; warn logs mismatches without blocking; enforce rejects them.
PACKRAT_INGEST_VALIDATION_MODE=

# ---------- PROXY ----------
PACKRAT_PROXY_PORT=                       # host port mapped to nginx container 80
